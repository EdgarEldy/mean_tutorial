PORT=3001
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=mean_db
DB_DIALECT=mysql
JWT_SECRET=change_this_to_a_long_random_string_in_production
# SMTP catcher for dev, e.g. MailHog (docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog),
# view sent mail at http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=no-reply@mean-tutorial.test
# Base URL of the Angular app, used to build activation/reset links in emails
FRONTEND_URL=http://localhost:4200
